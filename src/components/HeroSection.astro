---
import { personalInfo } from "@/lib/data";
import {
  DocumentAttachmentIcon,
  GithubIcon,
  Linkedin01Icon,
  Mail01Icon,
} from "@hugeicons/core-free-icons";
import Icon from "./Icon.astro";
import HeroCanvas from "./HeroCanvas.astro";

const contactLinks = [
  {
    label: "View resume",
    href: personalInfo.resumePage,
    icon: DocumentAttachmentIcon,
    external: true,
    primary: true,
  },
  { label: "Email", href: `mailto:${personalInfo.email}`, icon: Mail01Icon },
  { label: "GitHub", href: personalInfo.github, icon: GithubIcon, external: true },
  {
    label: "LinkedIn",
    href: personalInfo.linkedin,
    icon: Linkedin01Icon,
    external: true,
  },
];
---

<section
  class="relative isolate min-h-[calc(100svh-3.5rem)] overflow-hidden bg-hero-background text-hero-foreground"
>
  <HeroCanvas />
  <div class="hero-scrim absolute inset-0" aria-hidden="true"></div>
  <div class="hud-scanlines pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <p
    class="hud-spine pointer-events-none absolute bottom-10 left-3 hidden font-mono text-[0.7rem] uppercase tracking-[0.3em] text-hero-foreground/60 lg:block"
    aria-hidden="true"
  >
    Player 01 · Online
  </p>

  <div
    class="relative mx-auto grid min-h-[calc(100svh-3.5rem)] max-w-6xl items-center gap-9 px-6 py-10 md:px-8 md:py-16"
  >
    <div class="min-w-0 max-w-4xl">
      <div
        class="hero-reveal mb-5 flex items-center gap-3 font-mono text-xs font-bold uppercase tracking-[0.18em] text-hero-foreground/80 md:text-sm"
        style="--reveal-delay: 40ms"
      >
        <span class="h-3 w-3 animate-pulse bg-coral motion-reduce:animate-none" aria-hidden="true"></span>
        {personalInfo.role}
      </div>

      <h1
        class="hero-reveal font-display text-[clamp(2.4rem,11vw,5rem)] leading-[0.92] md:text-[clamp(4rem,8vw,6.5rem)]"
        style="--reveal-delay: 110ms"
      >
        {personalInfo.heroHeading.first}{" "}<span class="text-ember dark:text-coral">{personalInfo.heroHeading.last}</span>
      </h1>

      <p
        class="hero-reveal mt-6 max-w-[62ch] text-base leading-relaxed text-hero-foreground/82 md:text-lg"
        style="--reveal-delay: 180ms"
      >
        {personalInfo.heroDescription}
      </p>

      <div class="hero-reveal mt-7 flex flex-wrap gap-2.5" style="--reveal-delay: 250ms">
        {
          contactLinks.map(({ label, href, icon, external, primary }) => (
            <a
              href={href}
              {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              class={`btn-hud pressable group inline-flex min-h-12 items-center gap-2 px-5 pb-3.5 pt-2.5 text-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hero-foreground md:text-sm ${
                primary
                  ? "btn-hud-primary"
                  : "bg-hero-background/40 text-hero-foreground hover:bg-hero-foreground hover:text-hero-background"
              }`}
            >
              <Icon icon={icon} class="h-4 w-4" strokeWidth={2} />
              {label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
