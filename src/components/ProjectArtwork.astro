---
import type { ProjectArtwork } from "@/lib/data";

interface Props {
  artwork: ProjectArtwork;
}

const { artwork } = Astro.props;

const graphNodes = [
  { x: 18, y: 26, size: 13, tone: "bg-coral" },
  { x: 47, y: 14, size: 10, tone: "bg-acid" },
  { x: 74, y: 30, size: 15, tone: "bg-paper" },
  { x: 30, y: 62, size: 11, tone: "bg-acid" },
  { x: 60, y: 58, size: 17, tone: "bg-coral" },
  { x: 84, y: 70, size: 9, tone: "bg-acid" },
];

const graphEdges: [number, number][] = [
  [0, 1],
  [1, 2],
  [0, 3],
  [3, 4],
  [1, 4],
  [2, 4],
  [4, 5],
];
---

{
  artwork === "interviewer" && (
    <div class="relative aspect-4/3 overflow-hidden bg-ink text-white" aria-hidden="true">
      <div class="absolute left-[7%] top-[12%] h-[58%] w-[56%] border-2 border-acid bg-coral" />
      <div class="absolute left-[11%] top-[8%] h-[58%] w-[56%] border-2 border-white bg-ink">
        <div class="flex h-[16%] items-center gap-[3%] border-b border-white/30 px-[5%]">
          <span class="h-[clamp(0.35rem,1.4vw,0.6rem)] w-[clamp(0.35rem,1.4vw,0.6rem)] rounded-full bg-coral" />
          <span class="font-display text-[clamp(0.55rem,2vw,0.8rem)] text-white">LIVE · ZOOM</span>
        </div>
        <div class="absolute left-1/2 top-[50%] flex h-[clamp(2.6rem,10vw,4.6rem)] w-[clamp(2.6rem,10vw,4.6rem)] -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border-2 border-acid font-display text-[clamp(0.8rem,3vw,1.3rem)] text-acid">
          AI
        </div>
        <div class="absolute bottom-[9%] left-[8%] right-[8%] flex h-[20%] items-center gap-[3%]">
          {[30, 62, 88, 46, 74, 100, 54, 80, 38, 66].map((height) => (
            <span class="flex-1 bg-acid" style={`height: ${height}%`} />
          ))}
        </div>
      </div>
      <div class="absolute right-[5%] top-[9%] grid w-[23%] gap-2 font-display text-[clamp(0.58rem,2.1vw,0.85rem)] text-ink">
        <div class="bg-acid px-[8%] py-[12%] text-center">STT</div>
        <div class="text-center text-acid">↓</div>
        <div class="bg-coral px-[8%] py-[12%] text-center">LLM</div>
        <div class="text-center text-acid">↓</div>
        <div class="bg-paper px-[8%] py-[12%] text-center">TTS</div>
      </div>
      <div class="absolute bottom-[7%] left-[7%] flex items-baseline gap-[0.5em] font-display text-[clamp(0.8rem,3vw,1.25rem)]">
        <span class="text-white/55 line-through">6.0s</span>
        <span class="text-acid">→ 0.8s</span>
      </div>
      <div class="absolute bottom-[7%] right-[5%] font-display text-[clamp(0.7rem,2.5vw,1rem)] text-acid">
        RESPONSE TIME
      </div>
    </div>
  )
}

{
  artwork === "recruitment" && (
    <div class="relative aspect-4/3 overflow-hidden bg-acid text-ink" aria-hidden="true">
      <div class="absolute left-[6%] top-[9%] font-display text-[clamp(0.9rem,3.4vw,1.5rem)] leading-none">
        HIRING PIPELINE
      </div>
      <div class="absolute left-[6%] right-[6%] top-[22%] grid grid-cols-4 gap-[3%]">
        {["POST", "SCORE", "VERIFY", "BOOK"].map((stage, stageIndex) => (
          <div class="border-2 border-ink bg-paper">
            <div
              class={`border-b-2 border-ink px-[8%] py-[10%] text-center font-display text-[clamp(0.5rem,1.9vw,0.8rem)] ${
                stageIndex === 1 ? "bg-coral" : stageIndex === 3 ? "bg-ink text-white" : ""
              }`}
            >
              {stage}
            </div>
            <div class="grid gap-[clamp(0.2rem,0.9vw,0.4rem)] p-[10%]">
              {Array.from({ length: 4 - stageIndex }).map((_, cardIndex) => (
                <div class="flex items-center gap-[10%] border border-ink px-[8%] py-[8%]">
                  <span
                    class={`h-[clamp(0.4rem,1.5vw,0.65rem)] w-[clamp(0.4rem,1.5vw,0.65rem)] shrink-0 rounded-full ${
                      cardIndex === 0 ? "bg-coral" : "bg-ink/50"
                    }`}
                  />
                  <span class="h-1 w-full bg-ink/40" />
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
      <div class="absolute bottom-[8%] left-[6%] bg-ink px-[3%] py-[1.5%] font-display text-[clamp(0.65rem,2.4vw,0.95rem)] text-white">
        HUMAN IN THE LOOP
      </div>
      <div class="absolute bottom-[7%] right-[6%] font-display text-[clamp(1.2rem,4.6vw,2.2rem)] leading-none">
        −50%
      </div>
    </div>
  )
}

{
  artwork === "knowledge" && (
    <div class="relative aspect-4/3 overflow-hidden bg-ink text-white" aria-hidden="true">
      <svg class="absolute inset-0 h-full w-full" viewBox="0 0 100 75" preserveAspectRatio="none">
        {graphEdges.map(([from, to]) => {
          const a = graphNodes[from];
          const b = graphNodes[to];
          return a && b ? (
            <line
              x1={a.x}
              y1={a.y * 0.75}
              x2={b.x}
              y2={b.y * 0.75}
              stroke="currentColor"
              stroke-opacity="0.45"
              stroke-width="0.5"
            />
          ) : null;
        })}
      </svg>
      {graphNodes.map((node) => (
        <span
          class={`absolute -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-white ${node.tone}`}
          style={`left: ${node.x}%; top: ${node.y}%; width: ${node.size}%; aspect-ratio: 1`}
        />
      ))}
      <div class="absolute left-[6%] top-[80%] grid grid-cols-3 gap-[3%] font-display text-[clamp(0.5rem,1.9vw,0.8rem)] text-ink">
        <span class="bg-acid px-[0.6em] py-[0.3em]">ENTITY</span>
        <span class="bg-coral px-[0.6em] py-[0.3em]">RELATION</span>
        <span class="bg-paper px-[0.6em] py-[0.3em]">SOURCE</span>
      </div>
      <div class="absolute bottom-[8%] right-[5%] font-display text-[clamp(0.7rem,2.5vw,1rem)] text-acid">
        INGEST → GRAPH
      </div>
    </div>
  )
}

{
  artwork === "clinical" && (
    <div class="relative aspect-4/3 overflow-hidden bg-coral text-ink" aria-hidden="true">
      <div class="absolute left-[6%] top-[9%] h-[72%] w-[52%] border-2 border-ink bg-paper p-[6%]">
        <div class="font-display text-[clamp(0.95rem,3.6vw,1.8rem)] leading-none">REPORT</div>
        <div class="mt-[10%] h-[3%] w-[80%] bg-ink/25" />
        {[78, 64, 86, 52, 70].map((width) => (
          <div class="mt-[6%] h-1 bg-ink/60" style={`width: ${width}%`} />
        ))}
        <div class="absolute bottom-[8%] left-[10%] border-2 border-ink bg-acid px-[6%] py-[3%] font-display text-[clamp(0.6rem,2.2vw,0.9rem)]">
          DRAFT
        </div>
      </div>
      <div class="absolute right-[6%] top-[14%] w-[34%] border-2 border-ink bg-ink p-[4%] text-white shadow-[-8px_8px_0_0_var(--acid)]">
        <div class="font-display text-[clamp(0.65rem,2.4vw,1rem)]">AI AGENT</div>
        <div class="mt-[10%] grid gap-[clamp(0.2rem,0.9vw,0.4rem)]">
          {[90, 70, 80].map((width) => (
            <span class="h-1 bg-white/40" style={`width: ${width}%`} />
          ))}
        </div>
        <div class="mt-[14%] border border-white/50 px-[6%] py-[5%] text-center font-display text-[clamp(0.5rem,1.9vw,0.75rem)] text-acid">
          CHROMADB · RAG
        </div>
      </div>
      <div class="absolute bottom-[7%] right-[6%] flex items-center gap-[0.5em] font-display text-[clamp(0.65rem,2.4vw,0.95rem)]">
        <span class="flex h-[clamp(1.1rem,4vw,1.7rem)] w-[clamp(1.1rem,4vw,1.7rem)] items-center justify-center rounded-full bg-ink font-bold text-white">
          ✓
        </span>
        CLINICIAN DECIDES
      </div>
    </div>
  )
}
