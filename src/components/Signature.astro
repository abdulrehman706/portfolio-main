<style>
  .signature {
    display: block;
    overflow: visible;
  }

  .signature-animate .signature-letters {
    clip-path: inset(0 100% 0 0);
    animation: signature-write 1.1s cubic-bezier(0.55, 0.1, 0.35, 1) 0.15s forwards;
  }

  .signature-animate .signature-swoosh {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: signature-swoosh 0.55s ease-out 1.15s forwards;
  }

  @keyframes signature-write {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes signature-swoosh {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signature-animate .signature-letters,
    .signature-animate .signature-swoosh {
      animation: none;
      clip-path: none;
      stroke-dashoffset: 0;
    }
  }
</style>
